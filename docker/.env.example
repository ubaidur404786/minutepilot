# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
# any long random string; keep it: n8n uses it to encrypt saved credentials
N8N_ENCRYPTION_KEY=

# your own Gmail: minutes, agenda and reminders only go to this address and its + aliases
OWNER_EMAIL=
# ID of the "MinutePilot register" Google Sheet (the long part of its URL)
SHEET_ID=

TEXT_MODEL=qwen2.5:7b
VISION_MODEL=qwen2.5vl:3b
WHISPER_MODEL=small
# context window for the text model, in tokens (8192 fits ~5,000 words of notes)
NUM_CTX=8192

# Google Cloud OAuth client (Web application). Redirect URI:
#   http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
